# Copie para .env e substitua todos os valores de exemplo antes de executar a API.
# Nunca coloque credenciais reais neste arquivo versionado.
ENVIRONMENT=dev
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_HOST:5432/TEST_DB_NAME
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=sender@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=Unirides
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true
